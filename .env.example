# Copy this file to .env and fill in real values.
# NEVER commit .env.

# PostgreSQL connection string (Neon).
# Example:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Long random string for signing JWTs.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# HTTP port for the API server.
PORT=4000

# Comma-separated list of allowed CORS origins.
# For Expo dev: http://localhost:8081
# For Expo web: http://localhost:19006
WEB_ORIGIN=http://localhost:8081

# Username (lowercase) of the single Super Admin account.
# The next user to register with this username gets is_super_admin=true.
# Leave blank to disable auto-grant.
SUPER_ADMIN_USERNAME=

# 'development' or 'production'
NODE_ENV=development